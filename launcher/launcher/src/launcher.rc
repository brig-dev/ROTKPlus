#include <winver.h>
#include "version_rc.h"   /* written by build.sh from the VERSION file */
1 ICON "../art/rotkplus.ico"
1 VERSIONINFO
FILEVERSION VERSION_RC
PRODUCTVERSION VERSION_RC
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "ROTKPlus - launcher for The Return of the King (PC), based on Athelas by Shagg"
      VALUE "ProductName", "ROTKPlus"
      VALUE "FileVersion", VERSION_STR
      VALUE "ProductVersion", VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
1 24 "launcher.manifest"
